---
import { Icon } from "astro-icon/components";
import localData from "../data/home.json";

//Data Definitions
interface Social {
  name: string;
  url: string;
  icon: string;
}

interface ProfileData {
  name: string;
  photoUrl: string;
  intro: string;
  introHtml: string;
  resumeEnUrl: string;
  resumeEsUrl: string;
  socials: Social[];
}

const isApiLive = import.meta.env.PROD; // Auto true in production
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData; // data as ProfileData

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error("Network response was not ok");
    data = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
    data = localData as ProfileData;
  }
} else {
  data = localData as ProfileData;
}

const { name, photoUrl, intro, introHtml, resumeEnUrl, resumeEsUrl, socials } = data;
---

<section
  id="home"
  class="flex flex-col items-center justify-center section-container md:pt-30 gap-1 min-h-[80vh] text-center"
>
  <div
    class="relative group mb-2 reveal-content"
    style="animation-delay: 100ms;"
  >
    <div
      class="balloon-float w-20 h-20 md:w-24 md:h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_50px_rgba(164,118,255,0.2)]"
    >
      <img
        src={photoUrl}
        alt={name}
        onerror="this.onerror=null;this.src='/logo.png';"
        class="w-full h-full object-cover scale-110"
      />
    </div>
    <div
      class="balloon-float absolute -z-10 top-0 left-0 w-full h-full bg-accent rounded-full blur-[80px] opacity-20"
    >
    </div>
  </div>

  <div class="reveal-content" style="animation-delay: 200ms;">
    <p class="font-body font-light text-gray leading-relaxed">Hello, I'm</p>
  </div>

  <div
    class="px-6 sm:px-14 md:px-18 lg:px-40 max-w-360 mx-auto relative z-0 reveal-content"
    style="animation-delay: 300ms;"
  >
    <h1
      class="text-5xl md:text-7xl font-heading font-bold text-white tracking-tight"
    >
      {name}
    </h1>
    <br />
    <p
      class="text-gray font-body text-lg leading-relaxed"
      set:html={introHtml}
    />
  </div>

  <!-- Contenedor Principal del Dropdown -->
  <div class="mt-8 mb-4 reveal-content relative inline-block text-left group z-50" style="animation-delay: 400ms;">
    
    <!-- Botón Principal -->
    <button 
      class="relative inline-flex items-center justify-center px-8 py-3 bg-[#0a0a0a]/50 backdrop-blur-md border border-white/10 rounded-full text-white font-body transition-all duration-300
             group-hover:border-accent/50 group-hover:bg-accent/10 group-focus-within:border-accent/50
             cursor-pointer outline-none shadow-[0_0_20px_rgba(var(--accent-rgb),0.1)] group-hover:shadow-[0_0_25px_rgba(var(--accent-rgb),0.3)]"
    >
      <div class="flex items-center gap-3">
        <div class="flex flex-col items-start text-left">
          <span class="tracking-wide text-sm md:text-base font-semibold">Get Resume</span>
          <span class="text-[10px] text-gray-400 font-light">Select Language</span>
        </div>
        <Icon name="mdi:chevron-down" class="w-5 h-5 text-accent transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180" />
      </div>
    </button>

    <!-- Menú Dropdown -->
    <!-- FIX: Usamos pt-4 (padding) en lugar de mt-4 (margin) para crear un puente invisible y evitar que el hover se rompa -->
    <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 w-48 origin-top scale-95 opacity-0 pointer-events-none 
                transition-all duration-300 ease-out group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto
                group-focus-within:scale-100 group-focus-within:opacity-100 group-focus-within:pointer-events-auto">
      
      <div class="p-2 bg-[#0a0a0a]/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl">
        
        <!-- Opción Inglés -->
        <a 
          href={data.resumeEnUrl || "#"} 
          target="_blank"
          class="flex items-center justify-between px-4 py-3 rounded-xl hover:bg-white/10 transition-colors group/item"
        >
          <div class="flex flex-col text-left">
            <span class="text-sm font-medium text-white">English</span>
            <span class="text-[10px] text-gray-400">Professional CV</span>
          </div>
          <Icon name="circle-flags:us" class="w-5 h-5 opacity-80 group-hover/item:opacity-100 transition-opacity" />
        </a>

        <div class="h-px bg-white/10 my-1 mx-2"></div>

        <!-- Opción Español -->
        <a 
          href={data.resumeEsUrl || "#"} 
          target="_blank"
          class="flex items-center justify-between px-4 py-3 rounded-xl hover:bg-white/10 transition-colors group/item"
        >
          <div class="flex flex-col text-left">
            <span class="text-sm font-medium text-white">Español</span>
            <span class="text-[10px] text-gray-400">Hoja de Vida</span>
          </div>
          <Icon name="circle-flags:es" class="w-5 h-5 opacity-80 group-hover/item:opacity-100 transition-opacity" />
        </a>

      </div>
    </div>
  </div>
      <div
        class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"
      >
      </div>
    </a>
  </div>

  <div class="flex gap-6 mt-4 reveal-content" style="animation-delay: 500ms;">
    {
      socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110"
        >
          <Icon
            name={social.icon}
            class="w-8 h-8 text-white group-hover:text-accent transition-colors duration-300"
          />

          <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body">
            {social.name}
          </span>
        </a>
      ))
    }
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* profile photo floating animation */

  /* When combined, the animation rule automatically merges these transforms */
  .avatar-container {
    animation:
      float 5s ease-in-out infinite alternate,
      wobble 7s ease-in-out infinite alternate;
  }

  .balloon-float {
    will-change: transform;
    animation: floating-balloon 8s ease-in-out infinite;
  }

  @keyframes floating-balloon {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      /* Moves up and slightly right */
      transform: translate(3px, -8px) rotate(1deg);
    }
    66% {
      /* Drifts left and stays elevated */
      transform: translate(-3px, -4px) rotate(-1deg);
    }
    100% {
      /* Returns to start */
      transform: translate(0, 0) rotate(0deg);
    }
  }
</style>

<script>
  function revealSkills() {
    const cards = document.querySelectorAll(".skill-card");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Add a slight delay based on the card's position to create a wave effect
            const index = Array.from(cards).indexOf(entry.target);
            setTimeout(
              () => {
                entry.target.classList.add("reveal");
              },
              (index % 6) * 50,
            ); // Delay resets every row for a clean staggered look

            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1, // Trigger when 10% of the card is visible
        rootMargin: "0px 0px -50px 0px", // Trigger slightly before it hits the viewport
      },
    );

    cards.forEach((card) => observer.observe(card));
  }

  // Runs on initial load
  revealSkills();

  // Necessary for Astro View Transitions if you use them
  document.addEventListener("astro:after-swap", revealSkills);
</script>
